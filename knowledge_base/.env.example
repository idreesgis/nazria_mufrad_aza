# Nazria knowledge base — configuration example. Variable NAMES only: never put real keys or passwords
# in this file, in git, in the database or in logs. Load secrets from your secret manager / shell.

# --- database (format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require; URL-encode special chars, % -> %25)
NAZRIA_DATABASE_URL=
# disposable database for the DB tests only (the tests DROP schema "nazria" there)
NAZRIA_TEST_DATABASE_URL=

# --- engine: questionnaire (default, no AI) | llm | hybrid
NAZRIA_ENGINE=questionnaire

# --- provider: gemini (project default) | openai | deepseek | anthropic | local
NAZRIA_LLM_PROVIDER=gemini
# model name exactly as the provider knows it (default for gemini: gemini-3.5-flash)
NAZRIA_LLM_MODEL=gemini-3.5-flash
# local only: vllm | ollama | lmstudio | llamacpp  (default URLs :8000/v1, :11434/v1, :1234/v1, :8080/v1)
NAZRIA_LOCAL_STACK=
# optional: override the endpoint of the configured provider / local stack
NAZRIA_LLM_BASE_URL=
# optional: NAME of the env var that holds the key (defaults: OPENAI_API_KEY, DEEPSEEK_API_KEY,
# ANTHROPIC_API_KEY, GEMINI_API_KEY, NAZRIA_LOCAL_API_KEY)
NAZRIA_LLM_API_KEY_ENV=
NAZRIA_LLM_TEMPERATURE=0.2
NAZRIA_LLM_MAX_TOKENS=1024
NAZRIA_LLM_TIMEOUT_S=60
NAZRIA_LLM_MAX_RETRIES=3
# thinking models (Gemini 2.5+/3.x) spend part of NAZRIA_LLM_MAX_TOKENS on hidden reasoning; use e.g. 4096 for them
# minimum seconds between two requests to the provider (e.g. 6 for a free-tier Gemini key, about 10 requests/minute)
NAZRIA_LLM_MIN_INTERVAL_S=0
# longest "retry in N s" wait honoured after a 429; a longer one fails the request (the patient gets the questionnaire)
NAZRIA_LLM_RATE_LIMIT_WAIT_MAX_S=90
NAZRIA_RAG_TOP_K=4

# --- data policy: external providers (openai, deepseek, anthropic, gemini) refuse to run unless true.
# Gemini is the default provider, so set this to true for the llm / hybrid engines and for evaluate / review.
NAZRIA_ALLOW_EXTERNAL_PROVIDERS=false

# --- API keys (set in the environment / secret manager; shown here as names only)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NAZRIA_LOCAL_API_KEY=

# --- training export default: human_or_ai (for now) | human_only (once a Hakeem reviews)
NAZRIA_TRAINING_REVIEW_MODE=human_or_ai

# --- optional prices for the evaluation report (per million tokens, your contract prices)
# NAZRIA_PRICE_OPENAI_IN_PER_MTOK=
# NAZRIA_PRICE_OPENAI_OUT_PER_MTOK=

# --- REST API (Django) for the Android app: python manage.py runserver 0.0.0.0:8000
# required unless DJANGO_DEBUG=true; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# host names the API is served under (comma separated); in DEBUG defaults to localhost,127.0.0.1,10.0.2.2
DJANGO_ALLOWED_HOSTS=
# behind nginx/another proxy that terminates HTTPS: true enables the HTTPS redirect and secure cookies
DJANGO_BEHIND_HTTPS_PROXY=false
DJANGO_HSTS_SECONDS=0
# schema for Django's own tables in the same database (never "public"): python manage.py create_api_schema
NAZRIA_API_DB_SCHEMA=nazria_api
# every request needs the app key (header X-Api-Key); patients/staff also log in (Authorization: Bearer …)
NAZRIA_REQUIRE_APP_KEY=true
# requests per logged-in user (per IP otherwise): all endpoints / AI explanations / login+register / pulse uploads
NAZRIA_API_RATE=60/min
NAZRIA_API_EXPLAIN_RATE=10/min
NAZRIA_API_AUTH_RATE=10/min
NAZRIA_API_PULSE_RATE=10/min
# login tokens: access token minutes, refresh token days
NAZRIA_JWT_ACCESS_MINUTES=30
NAZRIA_JWT_REFRESH_DAYS=30
# Social sign-in through django-allauth (docs/API.md, "Provider setup"); empty = that provider is off.
# Only NAZRIA_FACEBOOK_APP_SECRET is a secret.
NAZRIA_GOOGLE_CLIENT_IDS=
NAZRIA_FACEBOOK_APP_ID=
NAZRIA_FACEBOOK_APP_SECRET=
NAZRIA_APPLE_CLIENT_IDS=
NAZRIA_MICROSOFT_CLIENT_ID=
NAZRIA_MICROSOFT_TENANT=common
# public https:// address of the server (Sign in with Apple returns to it)
NAZRIA_PUBLIC_URL=
# 03001234567 -> +923001234567
NAZRIA_DEFAULT_COUNTRY_CODE=92
# pulse videos (kept permanently, never served publicly) and the admin's static files
NAZRIA_MEDIA_ROOT=
NAZRIA_STATIC_ROOT=
NAZRIA_PULSE_MAX_MB=100
# false while the server is reached over plain HTTP (passwords and health data are then NOT encrypted)
NAZRIA_HTTPS=true
# behind nginx on the same machine: take the client IP for the audit log from X-Forwarded-For
NAZRIA_TRUST_PROXY=false
# rate-limit counters: locmem (one process) | db (several gunicorn workers; python manage.py createcachetable)
NAZRIA_API_CACHE=locmem
# OpenAPI + Swagger UI at /api/schema/ and /api/docs/ (default: on only when DJANGO_DEBUG=true)
NAZRIA_API_DOCS=
# Django admin at /admin/ (API keys, consultation log)
NAZRIA_ADMIN=true
# seconds before a Hakeem's questionnaire edit reaches the API
NAZRIA_QUESTIONS_CACHE_S=60
