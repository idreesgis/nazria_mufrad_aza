# /etc/nazria/nazria.env  – owner root, group nazria, mode 640 (it holds secrets: never commit it)
# Read by systemd (nazria-api.service). One VAR=value per line, no quotes, no "export".

DJANGO_SECRET_KEY=change-me-run-python3-c-import-secrets-print-secrets.token_urlsafe-50
DJANGO_DEBUG=false
# the server's public IP (and localhost for health checks on the machine)
DJANGO_ALLOWED_HOSTS=203.0.113.10,localhost,127.0.0.1
# admin login form over plain HTTP: the browser posts from this origin (with the port if not 80, e.g. :95)
DJANGO_CSRF_TRUSTED_ORIGINS=http://203.0.113.10

# PostgreSQL (the same database as the knowledge base); special characters URL-encoded, % -> %25
NAZRIA_DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DBNAME?sslmode=require
NAZRIA_API_DB_SCHEMA=nazria_api

# plain HTTP for now (passwords and health data are NOT encrypted on the network) – set true once HTTPS is set up
NAZRIA_HTTPS=false
# nginx or Apache on the same machine passes the client IP (for the audit log)
NAZRIA_TRUST_PROXY=true
# rate limits shared by all gunicorn workers (python manage.py createcachetable)
NAZRIA_API_CACHE=db

# Social sign-in (docs/API.md, "Provider setup"). Empty = that button is hidden in the app.
# Google: the "Web application" OAuth client ID (several: comma-separated). Not a secret.
NAZRIA_GOOGLE_CLIENT_IDS=
# Facebook: the App ID (not a secret) and the App secret (A SECRET: only here, never in git)
NAZRIA_FACEBOOK_APP_ID=
NAZRIA_FACEBOOK_APP_SECRET=
# Apple: the Services ID (then iOS bundle IDs, comma-separated); needs NAZRIA_PUBLIC_URL=https://...
NAZRIA_APPLE_CLIENT_IDS=
# Microsoft: the Application (client) ID; tenant: common | consumers | organizations | <tenant id>
NAZRIA_MICROSOFT_CLIENT_ID=
NAZRIA_MICROSOFT_TENANT=common
# The server's public HTTPS address (Sign in with Apple returns to it), e.g. https://nazria.example.com
NAZRIA_PUBLIC_URL=

NAZRIA_MEDIA_ROOT=/var/lib/nazria/media
NAZRIA_STATIC_ROOT=/var/lib/nazria/static
NAZRIA_PULSE_MAX_MB=100
NAZRIA_API_DOCS=false

# AI explanation: off until you switch it (questionnaire | hybrid)
NAZRIA_ENGINE=questionnaire
# NAZRIA_LLM_PROVIDER=gemini
# NAZRIA_LLM_MODEL=gemini-3.5-flash
# NAZRIA_ALLOW_EXTERNAL_PROVIDERS=true
# GEMINI_API_KEY=
# NAZRIA_LLM_MAX_TOKENS=4096
